# Non-secret env for the development cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets (APP_KEYS, *_JWT_SECRET, API_TOKEN_SALT, MINIO_*_KEY) live in Passbolt.

# production on every cluster: anything else loads config/database.ts (sqlite)
# instead of config/env/production/ (Postgres + S3 uploads).
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=768

MINIO_BUCKET=general-strapi
MINIO_PRIVATE_ENDPOINT=https://s3.bratislava.sk
MINIO_PUBLIC_ENDPOINT=https://general-strapi.s3.bratislava.sk
