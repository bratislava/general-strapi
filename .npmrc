# Do not resolve package versions published less than 7 days ago (npm >= 11.10.0).
min-release-age=7
# engine-strict is intentionally not set: @strapi/* 4.10.8 declare node <=18.x,
# while npm >= 11.10.0 needs node >= 20.17, so engine-strict would fail every install.
# The npm version is enforced by devEngines in package.json instead.
